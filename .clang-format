---
Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4      # public:/private: line up with the class brace
IndentCaseLabels: true        # indent case labels inside switch
NamespaceIndentation: All     # indent contents of namespaces
IndentPPDirectives: BeforeHash

# Braces on their own line (Allman)
BreakBeforeBraces: Allman

# Line breaking / wrapping
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# Spacing / pointers
PointerAlignment: Left        # int* p;  not  int *p;
SpaceBeforeParens: ControlStatements

# Includes
SortIncludes: true
